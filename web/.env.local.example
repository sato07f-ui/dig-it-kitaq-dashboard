# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Server-only: used to send invitation emails via supabase.auth.admin.
# Never prefix this with NEXT_PUBLIC_ -- it must not reach the browser bundle.
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Used to build absolute links in emails (invite, password reset).
NEXT_PUBLIC_SITE_URL=http://localhost:3000
