# Slack app credentials (Socket Mode)
SLACK_BOT_TOKEN=xoxb-xxxxxxxxxxxx
SLACK_APP_TOKEN=xapp-xxxxxxxxxxxx

# Path to the claude CLI binary. Leave as "claude" if it's on PATH.
CLAUDE_BIN=claude

# Seconds to wait for a single claude -p call before giving up.
CLAUDE_TIMEOUT_SECONDS=120

# Supabase project (service_role key -- server-side only, never expose to
# Slack users or the browser; it bypasses Row Level Security).
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Base URL of the web app, used in Slack messages (e.g. /link instructions).
WEB_APP_URL=http://localhost:3000

# Time of day (Asia/Tokyo, always -- not the server's local timezone) to run
# the due-date alert batch. Accepts "H" (e.g. 9) or "H:MM" (e.g. 15:52).
ALERT_HOUR=9
